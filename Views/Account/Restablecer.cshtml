@model RestablecerVm
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_LayoutPublico";
}
<div class="tarjeta-centro">
    <h1>Nueva contraseña</h1>
    <form asp-action="Restablecer" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="aviso aviso-error"></div>
        <input type="hidden" asp-for="Correo" />
        <input type="hidden" asp-for="Token" />
        <label asp-for="NuevaClave"></label>
        <input asp-for="NuevaClave" autocomplete="new-password" />
        <span asp-validation-for="NuevaClave" class="error-campo"></span>
        <label asp-for="Confirmar"></label>
        <input asp-for="Confirmar" autocomplete="new-password" />
        <span asp-validation-for="Confirmar" class="error-campo"></span>
        <button type="submit" class="btn btn-primario btn-bloque">Guardar contraseña</button>
    </form>
</div>
