@model RepartidorFormVm
@{ ViewData["Title"] = "Editar repartidor"; }
<div class="cabecera"><h1>Editar repartidor</h1><p class="sub">@Model.Nombre</p></div>
<form class="tarjeta formulario estrecho" asp-action="Editar" asp-route-id="@Model.Id" method="post" novalidate>
    <div asp-validation-summary="All" class="aviso aviso-error"></div>
    <label asp-for="ZonaId">Zona asignada</label>
    <select asp-for="ZonaId" asp-items="Model.Zonas"><option value="">Sin zona fija</option></select>
    <label asp-for="Capacidad">Capacidad (paradas)</label>
    <input asp-for="Capacidad" type="number" min="1" max="200" />
    <span asp-validation-for="Capacidad" class="error-campo"></span>
    <div class="fila-2">
        <div><label asp-for="Vehiculo"></label><input asp-for="Vehiculo" /></div>
        <div><label asp-for="Placa"></label><input asp-for="Placa" /></div>
    </div>
    <label class="check"><input type="checkbox" asp-for="Disponibilidad" /> Disponible para recibir pedidos</label>
    <div class="barra-acciones">
        <a class="btn btn-linea" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primario">Guardar</button>
    </div>
</form>
